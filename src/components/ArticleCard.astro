---
interface Props { id: string; title: string; description: string; pubDate: Date; category?: string | undefined; tags?: string[] | undefined; mood?: string | undefined; }
const { id, title, description, pubDate, category } = Astro.props;
---
<a class="article-row" data-reveal href={'/articles/' + id + '/'}>
  <time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0,10).replaceAll('-','.')}</time>
  <div><span class="category">{category || '随笔'}</span><h3>{title}</h3><p>{description}</p></div>
  <span class="article-arrow" aria-hidden="true">↗</span>
</a>
