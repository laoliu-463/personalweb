---
// 《雾隐·陈墨》声光联动交互胶囊：黑胶唱机 + 四态风光切换台 + 环境声波
---

<div
  id="mood-widget"
  transition:persist="mood-widget"
  class="fixed bottom-6 right-6 z-[60] flex flex-col items-end select-none"
  role="region"
  aria-label="声光控制胶囊"
>
  <!-- 可折叠展开的声光控制面板 -->
  <div
    id="mood-capsule-panel"
    class="glass-panel mb-3 p-4 rounded-2xl shadow-2xl w-64 border border-[var(--border-color)] transition-all duration-300 origin-bottom-right scale-95 opacity-0 pointer-events-none transform translate-y-2"
    aria-hidden="true"
  >
    <!-- 面板标题与状态指示 -->
    <div class="flex items-center justify-between pb-3 border-b border-[var(--border-color)] mb-3">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--text-primary)] animate-pulse"></span>
        <span class="font-serif text-xs text-[var(--text-primary)] tracking-wider">声光控制台</span>
      </div>
      <div id="soundwave-bars" class="flex items-end gap-0.5 h-3">
        <span class="sound-bar w-0.5 h-1.5 bg-[var(--text-secondary)] rounded-full transition-all"></span>
        <span class="sound-bar w-0.5 h-3 bg-[var(--text-secondary)] rounded-full transition-all"></span>
        <span class="sound-bar w-0.5 h-2 bg-[var(--text-secondary)] rounded-full transition-all"></span>
        <span class="sound-bar w-0.5 h-2.5 bg-[var(--text-secondary)] rounded-full transition-all"></span>
      </div>
    </div>

    <!-- 1. 风光时序手动切换 -->
    <div class="mb-3.5">
      <div class="text-[10px] font-mono text-[var(--text-secondary)] mb-2 flex justify-between">
        <span>// SCENERY_MODE</span>
        <span id="active-scenery-name" class="text-[var(--text-primary)] font-serif">细雨</span>
      </div>
      <div class="grid grid-cols-4 gap-1.5" id="scenery-btn-group">
        <button
          type="button"
          data-mode="mist"
          class="scenery-pill py-1.5 px-2 rounded-lg text-[11px] font-serif border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all text-center cursor-pointer"
          title="迷雾 · 晨晓"
        >
          迷雾
        </button>
        <button
          type="button"
          data-mode="twilight"
          class="scenery-pill py-1.5 px-2 rounded-lg text-[11px] font-serif border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all text-center cursor-pointer"
          title="暮色 · 黄昏"
        >
          暮色
        </button>
        <button
          type="button"
          data-mode="rain"
          class="scenery-pill py-1.5 px-2 rounded-lg text-[11px] font-serif border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all text-center cursor-pointer"
          title="细雨 · 静谧"
        >
          细雨
        </button>
        <button
          type="button"
          data-mode="star"
          class="scenery-pill py-1.5 px-2 rounded-lg text-[11px] font-serif border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all text-center cursor-pointer"
          title="星野 · 深宵"
        >
          星野
        </button>
      </div>
    </div>

    <!-- 2. 音轨选择与播放状态 -->
    <div class="pt-2 border-t border-[var(--border-color)] flex items-center justify-between text-xs">
      <div class="flex flex-col truncate pr-2">
        <span class="text-[10px] font-mono text-[var(--text-secondary)]">// TRACK</span>
        <span id="current-track-name" class="font-sans text-[11px] text-[var(--text-primary)] truncate">潮湿夜雨 · Lofi Beat</span>
      </div>
      <button
        type="button"
        id="capsule-toggle-play"
        class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-mono bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90 transition-opacity cursor-pointer"
      >
        播放
      </button>
    </div>
  </div>

  <!-- 常态悬浮黑胶唱机组件 -->
  <div class="relative flex items-center gap-2">
    <!-- 面板展开触发胶囊提示 -->
    <button
      type="button"
      id="capsule-trigger-btn"
      class="group flex items-center gap-1.5 px-3 py-1.5 rounded-full glass-panel border border-[var(--border-color)] text-xs font-serif text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)] transition-all cursor-pointer shadow-lg"
      aria-label="展开声光控制台"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--text-primary)] opacity-70 group-hover:opacity-100"></span>
      <span id="trigger-label">声光</span>
    </button>

    <!-- 黑胶唱片本体 -->
    <div class="relative p-1.5 rounded-full bg-[var(--bg-card)] border border-[var(--border-color)] shadow-2xl">
      <audio id="bgm-audio" src="/bgm.mp3" loop preload="auto"></audio>

      <button
        type="button"
        id="vinyl-player-btn"
        class="relative flex items-center justify-center cursor-pointer select-none"
        aria-pressed="false"
        aria-label="播放背景音乐"
      >
        <svg id="vinyl-tonearm" class="tonearm-vercel" viewBox="0 0 32 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="26" cy="4" r="4" fill="#e5e7eb" stroke="#374151" stroke-width="1"/>
          <circle cx="26" cy="4" r="1.8" fill="#6b7280"/>
          <path d="M26 4L12 24L5 26.5L2 34.5L7 35.5L9.5 29.5L16 27L26 4Z" fill="url(#tonearm-metal-grad)"/>
          <rect x="1" y="32" width="6.5" height="4" rx="1" fill="#f9fafb" stroke="#1f2937" stroke-width="0.5"/>
          <defs>
            <linearGradient id="tonearm-metal-grad" x1="0" y1="0" x2="32" y2="38" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="50%" stop-color="#9ca3af"/>
              <stop offset="100%" stop-color="#374151"/>
            </linearGradient>
          </defs>
        </svg>

        <div id="vinyl-disc" class="vinyl-disc-vercel">
          <div class="vinyl-grooves-vercel"></div>
          <div class="vinyl-center-cover-vercel" id="vinyl-cover-icon">
            <svg data-icon="rain" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M5 2v9M8 1v11M11 3v8" />
            </svg>
            <svg data-icon="twilight" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="8" cy="7" r="2.5" />
              <path d="M2 12.5h12" stroke-linecap="round" />
            </svg>
            <svg data-icon="mist" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M2 6h12M3 9h10M4 12h8" />
            </svg>
            <svg data-icon="star" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <path d="M8 1.6l1.4 4.1h4.3L10.8 8.3l1.4 4.1L8 10l-4.2 2.4 1.4-4.1L2.3 5.7h4.3z" />
            </svg>
          </div>
          <div class="vinyl-center-hole-vercel"></div>
        </div>
      </button>
    </div>
  </div>
</div>

<style>
  /* 频谱跳动动画 */
  .sound-bar-anim:nth-child(1) { animation: wave 1.1s ease-in-out infinite alternate; }
  .sound-bar-anim:nth-child(2) { animation: wave 0.8s ease-in-out infinite alternate 0.2s; }
  .sound-bar-anim:nth-child(3) { animation: wave 1.3s ease-in-out infinite alternate 0.4s; }
  .sound-bar-anim:nth-child(4) { animation: wave 0.9s ease-in-out infinite alternate 0.1s; }

  @keyframes wave {
    0% { height: 4px; }
    100% { height: 12px; }
  }

  .scenery-pill.is-active {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
    font-weight: 500;
  }
</style>

<script>
  import { prefersReducedMotion, resolveScenery, setScenery, type SceneryMode } from '../lib/scenery';

  const STORAGE_KEY = 'bgm-muted';
  const BGM_VOLUME = 0.35;

  const SCENERY_LABELS: Record<SceneryMode, string> = {
    mist: '迷雾',
    twilight: '暮色',
    rain: '细雨',
    star: '星野',
  };

  function initMoodWidget() {
    if ((window as any).__MOOD_WIDGET_INITIALIZED__) return;
    (window as any).__MOOD_WIDGET_INITIALIZED__ = true;

    const audio = document.getElementById('bgm-audio') as HTMLAudioElement | null;
    const vinylBtn = document.getElementById('vinyl-player-btn');
    const vinylDisc = document.getElementById('vinyl-disc');
    const vinylTonearm = document.getElementById('vinyl-tonearm');
    const triggerBtn = document.getElementById('capsule-trigger-btn');
    const panel = document.getElementById('mood-capsule-panel');
    const capsulePlayBtn = document.getElementById('capsule-toggle-play');
    const soundBars = document.querySelectorAll('.sound-bar');
    const activeSceneryName = document.getElementById('active-scenery-name');
    const sceneryBtns = document.querySelectorAll<HTMLButtonElement>('.scenery-pill');

    if (!audio || !vinylBtn || !panel) return;

    const currentAudio: HTMLAudioElement = audio;
    currentAudio.volume = BGM_VOLUME;

    let userExplicitlyMuted = false;
    try {
      userExplicitlyMuted = localStorage.getItem(STORAGE_KEY) === '1';
    } catch (e) {}

    let isPanelOpen = false;

    function togglePanel(open?: boolean) {
      isPanelOpen = typeof open === 'boolean' ? open : !isPanelOpen;
      if (isPanelOpen) {
        panel?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95', 'translate-y-2');
        panel?.classList.add('opacity-100', 'pointer-events-auto', 'scale-100', 'translate-y-0');
        panel?.setAttribute('aria-hidden', 'false');
      } else {
        panel?.classList.add('opacity-0', 'pointer-events-none', 'scale-95', 'translate-y-2');
        panel?.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100', 'translate-y-0');
        panel?.setAttribute('aria-hidden', 'true');
      }
    }

    triggerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      togglePanel();
    });

    // 点击外部自动关闭控制台
    document.addEventListener('click', (e) => {
      if (isPanelOpen && !panel?.contains(e.target as Node) && !triggerBtn?.contains(e.target as Node)) {
        togglePanel(false);
      }
    });

    function updateSceneryUI(mode: SceneryMode) {
      if (activeSceneryName) activeSceneryName.textContent = SCENERY_LABELS[mode] || mode;
      sceneryBtns.forEach((btn) => {
        const btnMode = btn.getAttribute('data-mode');
        if (btnMode === mode) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });
    }

    // 初始化时同步当前选中的风光
    updateSceneryUI(resolveScenery());

    sceneryBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const mode = btn.getAttribute('data-mode') as SceneryMode | null;
        if (mode) {
          setScenery(mode);
          updateSceneryUI(mode);
        }
      });
    });

    window.addEventListener('scenery-change', (e: Event) => {
      const mode = (e as CustomEvent<SceneryMode>).detail;
      if (mode) updateSceneryUI(mode);
    });

    function setPlayingUi(playing: boolean) {
      vinylBtn?.setAttribute('aria-pressed', String(playing));
      vinylBtn?.setAttribute('aria-label', playing ? '暂停背景音乐' : '播放背景音乐');
      const reduce = prefersReducedMotion();
      vinylDisc?.classList.toggle('vinyl-playing-spin', playing && !reduce);
      vinylTonearm?.classList.toggle('tonearm-playing-drop', playing);

      if (capsulePlayBtn) {
        capsulePlayBtn.textContent = playing ? '暂停' : '播放';
      }

      soundBars.forEach((bar) => {
        if (playing && !reduce) {
          bar.classList.add('sound-bar-anim');
        } else {
          bar.classList.remove('sound-bar-anim');
        }
      });
    }

    function playBgm() {
      const p = currentAudio.play();
      if (p && typeof p.then === 'function') {
        p.then(() => setPlayingUi(true)).catch(() => {
          setPlayingUi(false);
          tryAutoplayOnFirstInteraction();
        });
      }
    }

    function pauseBgm() {
      currentAudio.pause();
      setPlayingUi(false);
    }

    let firstInteractionHandler: (() => void) | null = null;
    function tryAutoplayOnFirstInteraction() {
      if (firstInteractionHandler) return;
      firstInteractionHandler = () => {
        if (userExplicitlyMuted) return;
        playBgm();
        cleanupFirstInteraction();
      };
      window.addEventListener('click', firstInteractionHandler, { once: true });
      window.addEventListener('keydown', firstInteractionHandler, { once: true });
      window.addEventListener('touchstart', firstInteractionHandler, { once: true });
    }

    function cleanupFirstInteraction() {
      if (!firstInteractionHandler) return;
      window.removeEventListener('click', firstInteractionHandler);
      window.removeEventListener('keydown', firstInteractionHandler);
      window.removeEventListener('touchstart', firstInteractionHandler);
      firstInteractionHandler = null;
    }

    function handleTogglePlay() {
      if (currentAudio.paused) {
        userExplicitlyMuted = false;
        try { localStorage.setItem(STORAGE_KEY, '0'); } catch (err) {}
        cleanupFirstInteraction();
        playBgm();
      } else {
        userExplicitlyMuted = true;
        try { localStorage.setItem(STORAGE_KEY, '1'); } catch (err) {}
        pauseBgm();
      }
    }

    vinylBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      handleTogglePlay();
    });

    capsulePlayBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      handleTogglePlay();
    });

    if (!userExplicitlyMuted) {
      if (currentAudio.readyState >= 2) {
        playBgm();
      } else {
        currentAudio.addEventListener('canplay', playBgm, { once: true });
      }
    }

    document.addEventListener('astro:page-load', () => {
      if (!currentAudio.paused) {
        setPlayingUi(true);
      }
      updateSceneryUI(resolveScenery());
    });
  }

  initMoodWidget();
  document.addEventListener('astro:page-load', initMoodWidget);
</script>
