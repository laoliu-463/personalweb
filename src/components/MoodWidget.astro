---
// 黑胶背景音乐挂件：播放 /bgm.mp3，进入页面自动播放，点击黑胶切换开关
---

<div
  id="mood-widget"
  transition:persist="mood-widget"
  class="fixed bottom-7 right-7 z-[60] flex items-center justify-center p-2 rounded-full bg-[var(--bg-card)] border border-[var(--border-color)] shadow-2xl"
  role="region"
  aria-label="背景音乐播放"
>
  <audio id="bgm-audio" src="/bgm.mp3" loop preload="auto"></audio>

  <button
    type="button"
    id="vinyl-player-btn"
    class="relative flex items-center justify-center cursor-pointer select-none"
    aria-pressed="false"
    aria-label="播放背景音乐"
  >
    <svg id="vinyl-tonearm" class="tonearm-vercel" viewBox="0 0 32 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="26" cy="4" r="4" fill="#e5e7eb" stroke="#374151" stroke-width="1"/>
      <circle cx="26" cy="4" r="1.8" fill="#6b7280"/>
      <path d="M26 4L12 24L5 26.5L2 34.5L7 35.5L9.5 29.5L16 27L26 4Z" fill="url(#tonearm-metal-grad)"/>
      <rect x="1" y="32" width="6.5" height="4" rx="1" fill="#f9fafb" stroke="#1f2937" stroke-width="0.5"/>
      <defs>
        <linearGradient id="tonearm-metal-grad" x1="0" y1="0" x2="32" y2="38" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="50%" stop-color="#9ca3af"/>
          <stop offset="100%" stop-color="#374151"/>
        </linearGradient>
      </defs>
    </svg>

    <div id="vinyl-disc" class="vinyl-disc-vercel">
      <div class="vinyl-grooves-vercel"></div>
      <div class="vinyl-center-cover-vercel" id="vinyl-cover-icon">
        <svg data-icon="rain" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M5 2v9M8 1v11M11 3v8" />
        </svg>
        <svg data-icon="twilight" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="8" cy="7" r="2.5" />
          <path d="M2 12.5h12" stroke-linecap="round" />
        </svg>
        <svg data-icon="mist" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M2 6h12M3 9h10M4 12h8" />
        </svg>
        <svg data-icon="star" class="vinyl-scenery-icon" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M8 1.6l1.4 4.1h4.3L10.8 8.3l1.4 4.1L8 10l-4.2 2.4 1.4-4.1L2.3 5.7h4.3z" />
        </svg>
      </div>
      <div class="vinyl-center-hole-vercel"></div>
    </div>
  </button>
</div>

<script>
  import { prefersReducedMotion } from '../lib/scenery';

  const STORAGE_KEY = 'bgm-muted';
  const BGM_VOLUME = 0.35;

  function initMoodWidget() {
    if ((window as any).__MOOD_WIDGET_INITIALIZED__) return;
    (window as any).__MOOD_WIDGET_INITIALIZED__ = true;

    const audio = document.getElementById('bgm-audio') as HTMLAudioElement | null;
    const vinylBtn = document.getElementById('vinyl-player-btn');
    const vinylDisc = document.getElementById('vinyl-disc');
    const vinylTonearm = document.getElementById('vinyl-tonearm');

    if (!audio || !vinylBtn) return;

    audio.volume = BGM_VOLUME;

    let userExplicitlyMuted = false;
    try {
      userExplicitlyMuted = localStorage.getItem(STORAGE_KEY) === '1';
    } catch (e) {}

    function setPlayingUi(playing: boolean) {
      vinylBtn?.setAttribute('aria-pressed', String(playing));
      vinylBtn?.setAttribute('aria-label', playing ? '暂停背景音乐' : '播放背景音乐');
      const reduce = prefersReducedMotion();
      vinylDisc?.classList.toggle('vinyl-playing-spin', playing && !reduce);
      vinylTonearm?.classList.toggle('tonearm-playing-drop', playing);
    }

    function playBgm() {
      const p = audio.play();
      if (p && typeof p.then === 'function') {
        p.then(() => setPlayingUi(true)).catch(() => {
          // 浏览器阻止自动播放，等待用户首次交互后再播
          setPlayingUi(false);
          tryAutoplayOnFirstInteraction();
        });
      }
    }

    function pauseBgm() {
      audio.pause();
      setPlayingUi(false);
    }

    let firstInteractionHandler: (() => void) | null = null;
    function tryAutoplayOnFirstInteraction() {
      if (firstInteractionHandler) return;
      firstInteractionHandler = () => {
        if (userExplicitlyMuted) return;
        playBgm();
        cleanupFirstInteraction();
      };
      window.addEventListener('click', firstInteractionHandler, { once: true });
      window.addEventListener('keydown', firstInteractionHandler, { once: true });
      window.addEventListener('touchstart', firstInteractionHandler, { once: true });
    }

    function cleanupFirstInteraction() {
      if (!firstInteractionHandler) return;
      window.removeEventListener('click', firstInteractionHandler);
      window.removeEventListener('keydown', firstInteractionHandler);
      window.removeEventListener('touchstart', firstInteractionHandler);
      firstInteractionHandler = null;
    }

    vinylBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (audio.paused) {
        userExplicitlyMuted = false;
        try { localStorage.setItem(STORAGE_KEY, '0'); } catch (err) {}
        cleanupFirstInteraction();
        playBgm();
      } else {
        userExplicitlyMuted = true;
        try { localStorage.setItem(STORAGE_KEY, '1'); } catch (err) {}
        pauseBgm();
      }
    });

    // 音频加载完成后尝试自动播放
    if (!userExplicitlyMuted) {
      if (audio.readyState >= 2) {
        playBgm();
      } else {
        audio.addEventListener('canplay', playBgm, { once: true });
      }
    }

    // 页面切换后保持播放状态同步
    document.addEventListener('astro:page-load', () => {
      if (!audio.paused) {
        setPlayingUi(true);
      }
    });
  }

  initMoodWidget();
  document.addEventListener('astro:page-load', initMoodWidget);
</script>
