---
const path = Astro.url.pathname;
const items = [{label:'首页',href:'/'},{label:'作品',href:'/projects/'},{label:'文字',href:'/articles/'},{label:'自述',href:'/about/'}];
---
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="老刘，首页"><span class="brand-seal">L.</span><span>老刘<span class="brand-en">LAO LIU</span></span></a>
    <nav class="site-nav" aria-label="主导航">{items.map(item => <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
    <a class="header-github" href="https://github.com/laoliu-463" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
  </div>
</header>
