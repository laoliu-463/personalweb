---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: '作品', href: '/projects' },
  { label: '博客', href: '/blog' },
  { label: '随笔', href: '/notes' },
  { label: '自述', href: '/about' },
];

const githubLink = 'https://github.com/laoliu-463';

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 px-8 md:px-[6vw] py-4 sm:py-8 mix-blend-difference">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="font-serif text-lg tracking-wider text-[#e5e3dc] hover:opacity-80 transition-opacity">
        雾隐 <span class="font-sans font-light text-xs text-[#8c8d93] ml-1">Lao Liu</span>
      </a>

      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="打开菜单"
      >
        <svg class="nav-icon-open" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 5h12M3 9h12M3 13h12" stroke-linecap="round" />
        </svg>
        <svg class="nav-icon-close hidden" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4l10 10M14 4L4 14" stroke-linecap="round" />
        </svg>
      </button>
    </div>

<nav id="site-nav" class="text-xs font-sans text-[#8c8d93] flex items-center gap-6" aria-label="站点">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`nav-link transition-colors duration-300 ${
                active ? 'text-[#e5e3dc] font-normal border-b border-[#e5e3dc]' : 'hover:text-[#e5e3dc]'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
      <a href={githubLink} target="_blank" rel="noopener noreferrer" class="nav-link transition-colors duration-300 hover:text-[#e5e3dc]">
        GitHub ↗
      </a>
    </nav>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  function initNav() {
    cleanup?.();

    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('site-nav');
    const header = document.getElementById('site-header');
    if (!toggle || !nav) return;

    const openIcon = toggle.querySelector('.nav-icon-open');
    const closeIcon = toggle.querySelector('.nav-icon-close');

    function setOpen(open: boolean) {
      nav?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    }

    const onToggle = (event: Event) => {
      event.stopPropagation();
      setOpen(!nav.classList.contains('is-open'));
    };

    const onDocumentClick = (event: MouseEvent) => {
      if (!nav.classList.contains('is-open')) return;
      if (header?.contains(event.target as Node)) return;
      setOpen(false);
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    };

    const onNavClick = (event: Event) => {
      if ((event.target as HTMLElement | null)?.closest('a')) {
        setOpen(false);
      }
    };

    toggle.addEventListener('click', onToggle);
    nav.addEventListener('click', onNavClick);
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('keydown', onKeydown);

    cleanup = () => {
      setOpen(false);
      toggle.removeEventListener('click', onToggle);
      nav.removeEventListener('click', onNavClick);
      document.removeEventListener('click', onDocumentClick);
      document.removeEventListener('keydown', onKeydown);
    };
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
