---
interface Props { index?: number; title: string; description: string; tags: string[]; github?: string | undefined; demo?: string | undefined; year?: string | undefined; featured?: boolean; }
const { index = 1, title, description, tags = [], github, demo, year } = Astro.props;
const href = github || demo;
---
<article class="project-card" data-reveal>
  <span class="project-no" aria-hidden="true">{String(index).padStart(2,'0')}</span>
  <div class="project-body">
    <div class="project-caption"><h3><a href={href} target="_blank" rel="noopener noreferrer">{title}</a></h3>{year && <span class="project-year">{year}</span>}</div>
    {description && <p class="project-description">{description}</p>}
    <div class="project-links">
      {github && <a class="project-url" href={github} target="_blank" rel="noopener noreferrer"><span class="project-link-label">GitHub</span><span class="project-link-address">{github}</span><span class="project-link-arrow" aria-hidden="true">↗</span></a>}
      {demo && demo !== github && <a class="project-url" href={demo} target="_blank" rel="noopener noreferrer"><span class="project-link-label">网站</span><span class="project-link-address">{demo}</span><span class="project-link-arrow" aria-hidden="true">↗</span></a>}
    </div>
    {tags.length > 0 && <p class="project-meta">{tags.join(' / ')}</p>}
  </div>
</article>
