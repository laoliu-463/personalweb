---
interface Props {
  index?: number;
  title: string;
  description: string;
  tags: string[];
  github?: string | undefined;
  demo?: string | undefined;
  year?: string | undefined;
}

const { index = 1, title, description, tags, github, demo, year = '2024' } = Astro.props;
const formattedNum = String(index).padStart(2, '0');
const href = github ?? demo;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="work-item group block no-underline">
  <!-- 沉香酒红悬浮微光 -->
  <div class="work-glow"></div>

  <!-- 编号 -->
  <div class="work-num font-mono">{formattedNum}</div>

  <!-- 标题与副标题描述 -->
  <div class="work-title">
    <span>{title}</span>
    <span class="sub">{description}</span>

    <!-- 链接动作 -->
    <div class="flex items-center gap-4 mt-3 text-xs font-sans text-[#8c8d93] opacity-0 group-hover:opacity-100 transition-opacity">
      {github && (
        <span class="flex items-center gap-1">
          <span>GitHub</span>
          <span>↗</span>
        </span>
      )}
      {demo && demo !== github && (
        <span class="flex items-center gap-1">
          <span>演示</span>
          <span>↗</span>
        </span>
      )}
      <div class="flex gap-2 ml-auto">
        {tags.map((t) => <span class="px-2 py-0.5 bg-[#191a20] border border-[rgba(229,227,220,0.12)] text-[10px]">{t}</span>)}
      </div>
    </div>
  </div>

  <!-- 年份 -->
  <div class="work-year font-mono">{year}</div>
</a>
