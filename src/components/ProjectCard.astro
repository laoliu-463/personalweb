---
interface Props {
  index?: number;
  title: string;
  description: string;
  tags: string[];
  github?: string | undefined;
  demo?: string | undefined;
  year?: string | undefined;
  featured?: boolean | undefined;
  class?: string | undefined;
}

const {
  index = 1,
  title,
  description,
  tags = [],
  github,
  demo,
  year = '2025',
  featured = false,
  class: className = '',
} = Astro.props;

const formattedNum = String(index).padStart(2, '0');
const primaryHref = demo || github || '#';
---

<div
  class={`spotlight-card group block relative p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 ${
    featured ? 'md:col-span-2 min-h-[220px]' : 'min-h-[200px]'
  } ${className}`}
  data-spotlight
>
  <!-- 顶部窗体状态与编号 -->
  <div class="flex items-center justify-between gap-3 text-xs font-mono text-[var(--text-secondary)] mb-4">
    <div class="flex items-center gap-2">
      <!-- 极简工坊视窗圆点 -->
      <div class="flex items-center gap-1.5 opacity-60 group-hover:opacity-100 transition-opacity">
        <span class="w-2 h-2 rounded-full bg-[var(--text-secondary)] opacity-40"></span>
        <span class="w-2 h-2 rounded-full bg-[var(--text-secondary)] opacity-40"></span>
      </div>
      <span class="text-[11px] font-mono tracking-wider opacity-80">{formattedNum}</span>
    </div>

    <div class="flex items-center gap-3">
      {featured && (
        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono tracking-tight bg-[var(--wine)] text-[var(--text-primary)] opacity-90">
          FEATURED
        </span>
      )}
      <span class="text-[11px] font-mono opacity-70">{year}</span>
    </div>
  </div>

  <!-- 中部标题与描述 -->
  <div class="my-auto py-2">
    <h3 class="font-serif text-xl sm:text-2xl text-[var(--text-primary)] font-normal mb-2.5 group-hover:text-white transition-colors flex items-center justify-between gap-2">
      <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="hover:underline focus:outline-hidden">
        {title}
      </a>
      <span class="text-xs font-mono text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
        ↗
      </span>
    </h3>
    <p class="text-xs sm:text-sm font-sans text-[var(--text-secondary)] leading-relaxed line-clamp-2 sm:line-clamp-3">
      {description}
    </p>
  </div>

  <!-- 底部标签与操作链接 -->
  <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap items-center justify-between gap-3 mt-4 text-xs font-sans">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 rounded-md text-[10px] font-mono bg-[rgba(229,227,220,0.04)] border border-[rgba(229,227,220,0.08)] text-[var(--text-secondary)]">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-3 font-mono text-[11px] text-[var(--text-secondary)]">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">
          GitHub
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">
          预览
        </a>
      )}
    </div>
  </div>
</div>

<script>
  function setupSpotlight() {
    const cards = document.querySelectorAll<HTMLElement>('[data-spotlight]');
    cards.forEach((card) => {
      // 避免重复绑定
      if ((card as any).__SPOTLIGHT_INIT__) return;
      (card as any).__SPOTLIGHT_INIT__ = true;

      const onMouseMove = (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      };

      card.addEventListener('mousemove', onMouseMove, { passive: true });
    });
  }

  setupSpotlight();
  document.addEventListener('astro:page-load', setupSpotlight);
</script>
