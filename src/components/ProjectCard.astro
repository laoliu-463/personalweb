---
interface Props { index?: number; title: string; description: string; tags: string[]; github?: string | undefined; demo?: string | undefined; year?: string | undefined; featured?: boolean; }
const { index = 1, title, description, tags = [], github, demo, year } = Astro.props;
const href = demo || github;
---
<article class="project-card" data-reveal>
  <a class:list={['project-cover', 'cover-' + ((index - 1) % 3)]} href={href} target="_blank" rel="noopener noreferrer" aria-label={'查看项目 ' + title}>
    <img src="/art/urban-bedroom-empty-v5-mobile.webp" width="960" height="640" loading="lazy" alt="" />
    <span class="project-no">{String(index).padStart(2,'0')}</span><span class="cover-label">{tags[0] || 'EXPERIMENT'} / {year || 'PROJECT'}</span><span class="cover-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-caption"><h3><a href={href} target="_blank" rel="noopener noreferrer">{title}</a></h3>{year && <span class="project-year">{year}</span>}</div>
  <p class="project-description">{description || '一个持续探索中的项目。'}</p>
  <div class="project-meta"><span>{tags.join(' / ') || '代码实验'}</span><span class="project-actions">{github && <a href={github} target="_blank" rel="noopener noreferrer">源码 ↗</a>}{demo && <a href={demo} target="_blank" rel="noopener noreferrer">预览 ↗</a>}</span></div>
</article>
