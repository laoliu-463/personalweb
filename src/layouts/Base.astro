---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lao Liu 的个人网站：文章与项目' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">laoliu</a>
      <nav>
        <a href="/">首页</a>
        <a href="/blog/">文章</a>
        <a href="/projects/">项目</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Lao Liu</span>
      <span>
        <a href="https://github.com/laoliu-463">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
  </body>
</html>
