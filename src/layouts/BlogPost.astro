---
import Base from './Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { formatDate } from '../lib/format';
interface Props { title: string; description: string; pubDate: Date; updatedDate?: Date | undefined; category?: string | undefined; tags?: string[] | undefined; mood?: string | undefined; headings?: { depth: number; slug: string; text: string }[] | undefined; }
const { title, description, pubDate, updatedDate, category, tags = [], headings = [] } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={title + ' — 老刘'} description={description}>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>
  <PageIntro eyebrow={formatDate(pubDate) + (category ? ' / ' + category : '')} title={title} description={description}>
    <a class="text-link" href="/articles/" style="margin-top:20px">← 返回文章列表</a>
  </PageIntro>
  <div class="page-content shell reading-layout">
    <aside class="article-toc">
      <p class="eyebrow">CONTENTS / 目录</p>
      {toc.length ? <ol>{toc.map(item => <li class={item.depth === 3 ? 'toc-nested' : ''}><a href={'#' + item.slug}>{item.text}</a></li>)}</ol> : <p style="margin-top:16px">慢慢读，不着急。</p>}
    </aside>
    <div style="min-width:0">
      <article class="article-prose"><slot /></article>
      <div class="article-end"><div class="article-tags">{tags.map(tag => <span>#{tag}</span>)}</div><span>{updatedDate ? '修订于 ' + formatDate(updatedDate) : '感谢读到这里。'}</span></div>
      <a class="text-link" style="margin-top:24px" href="/articles/">← 继续读些文字</a>
    </div>
  </div>
</Base>
<script>
  const bar = document.querySelector<HTMLElement>('#read-progress');
  if (bar) {
    const update = () => {
      const range = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = 'scaleX(' + (range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0) + ')';
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
