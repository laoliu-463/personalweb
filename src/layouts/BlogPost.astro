---
import Base from './Base.astro';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  category?: string | undefined;
  tags?: string[] | undefined;
  mood?: string | undefined;
  headings?: { depth: number; slug: string; text: string }[] | undefined;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  mood,
  headings = [],
} = Astro.props;

// 筛选出 h2, h3 作为目录
const toc = headings ? headings.filter((h) => h.depth >= 2 && h.depth <= 3) : [];
---

<Base title={`${title} — 屌丝`} description={description}>
  <!-- 顶部沉浸阅读进度指示条 -->
  <div id="read-progress" class="read-progress-bar" aria-hidden="true"></div>

  <div class="max-w-3xl mx-auto">
    <!-- 返回导航 -->
    <div class="mb-10">
      <a
        href="/articles"
        class="inline-flex items-center gap-2 text-xs font-mono px-3.5 py-1.5 rounded-full border border-[var(--border-color)] glass-panel text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)] transition-all"
      >
        <span>←</span>
        <span>返回文章列表</span>
      </a>
    </div>

    <!-- 文章头信息 -->
    <header class="mb-12 pb-8 border-b border-[var(--border-color)]">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[var(--text-secondary)] mb-5">
        <time datetime={pubDate.toISOString()} class="text-[var(--text-secondary)]">
          {formatDate(pubDate)}
        </time>
        {category && (
          <>
            <span class="opacity-30">/</span>
            <span class="text-[var(--text-primary)]">{category}</span>
          </>
        )}
        {updatedDate && (
          <>
            <span class="opacity-30">/</span>
            <span class="opacity-70">修订于 {formatDate(updatedDate)}</span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[var(--text-primary)] leading-[1.2] mb-6 font-normal tracking-tight">
        {title}
      </h1>

      {mood && (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md glass-panel border border-[var(--border-color)] text-xs font-mono text-[var(--text-secondary)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--text-primary)] opacity-60"></span>
          <span>心境坐标：<span class="font-serif italic text-[var(--text-primary)]">{mood}</span></span>
        </div>
      )}
    </header>

    <!-- 目录 TOC（如有） -->
    {toc.length > 0 && (
      <nav class="my-10 p-5 sm:p-6 rounded-2xl glass-panel border border-[var(--border-color)] text-xs font-mono shadow-lg">
        <div class="text-[var(--text-secondary)] mb-3 font-semibold tracking-wider flex items-center justify-between">
          <span>// 目录导读</span>
          <span class="opacity-60">{toc.length} 章节</span>
        </div>
        <ul class="space-y-2">
          {toc.map((item) => (
            <li class={item.depth === 3 ? 'ml-4 opacity-80' : ''}>
              <a href={`#${item.slug}`} class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1.5">
                <span class="opacity-40">#</span>
                <span>{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 正文内容：加大行距、温润排版 -->
    <article class="font-sans text-base text-[var(--text-secondary)] leading-relaxed space-y-6 article-prose">
      <slot />
    </article>

    <!-- 文章尾注与标签 -->
    <div class="mt-20 pt-8 border-t border-[var(--border-color)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-mono">
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-2.5 py-1 rounded-md bg-[rgba(229,227,220,0.04)] border border-[var(--border-color)] text-[var(--text-secondary)]">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <div class="font-serif italic text-[var(--text-secondary)] select-none opacity-80">
        “雨停了片刻，风光正在流转。”
      </div>
    </div>
  </div>
</Base>

<script>
  function initProgressBar() {
    const bar = document.getElementById('read-progress');
    if (!bar) return;

    function onScroll() {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        bar!.style.width = '0%';
        return;
      }
      const scrolled = (window.scrollY / docHeight) * 100;
      bar!.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initProgressBar();
  document.addEventListener('astro:page-load', initProgressBar);
</script>

<style is:global>
  .article-prose {
    color: var(--text-primary);
  }
  .article-prose h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--text-primary);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }
  .article-prose h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--text-primary);
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }
  .article-prose p {
    margin-bottom: 1.75rem;
    line-height: 1.85;
    font-weight: 300;
  }
  .article-prose blockquote {
    border-left: 2px solid var(--wine);
    background: var(--card-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1rem 1.5rem;
    color: var(--text-primary);
    font-style: italic;
    font-family: var(--font-serif);
    margin: 2.5rem 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .article-prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(229, 227, 220, 0.06);
    color: var(--text-primary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }
  .article-prose pre {
    background: #0f1014 !important;
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 2.5rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .article-prose pre code {
    background: transparent;
    border: none;
    color: var(--text-primary);
    padding: 0;
  }
  .article-prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
    space-y: 0.5rem;
  }
  .article-prose li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }
  .article-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.875rem;
  }
  .article-prose th,
  .article-prose td {
    border: 1px solid var(--border-color);
    padding: 0.85rem 1.25rem;
    text-align: left;
  }
  .article-prose th {
    background: var(--bg-card);
    color: var(--text-primary);
    font-weight: 500;
  }
</style>
