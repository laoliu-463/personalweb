---
import Base from '../layouts/Base.astro';

const skills = [
  { category: '核心语言', items: ['TypeScript', 'Rust', 'Go', 'Python', 'SQL'] },
  { category: '框架与全栈', items: ['Astro', 'React', 'Next.js', 'Node.js', 'Tailwind CSS'] },
  { category: '工程与基础设施', items: ['Docker', 'Vercel', 'Git / GitHub Actions', 'Vite', 'PostgreSQL'] },
  { category: '实验偏好', items: ['Canvas 粒子', 'Web Audio API', '潮湿雨夜氛围', '水墨交互'] },
];
---

<Base title="自述 — 屌丝" description="关于 Lao Liu：潮湿光线里的文字、经历与信号">
  <div class="max-w-4xl mx-auto space-y-16 pt-4">
    <!-- 主体自述卡片图文分栏 -->
    <div class="about grid grid-cols-1 md:grid-cols-[0.85fr_1.15fr] gap-10 items-stretch">
      <!-- 左侧艺术图框 -->
      <div class="about-figure min-h-[360px] glass-panel border border-[var(--border-color)] relative overflow-hidden rounded-2xl shadow-2xl flex flex-col justify-between p-7 group">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[rgba(20,21,26,0.6)] to-[var(--bg-primary)] z-0"></div>
        <div class="absolute -right-8 -top-8 w-36 h-36 bg-[var(--wine)] opacity-25 blur-3xl rounded-full pointer-events-none"></div>

        <div class="relative z-10 flex items-center justify-between font-mono text-xs text-[var(--text-secondary)]">
          <span>// PORTRAIT</span>
          <span class="w-2 h-2 rounded-full bg-[var(--text-primary)] opacity-50"></span>
        </div>

        <div class="relative z-10 space-y-3">
          <div class="font-serif text-xl sm:text-2xl text-[var(--text-primary)] italic leading-relaxed">
            “大部分时间，我在等一种光。”
          </div>
          <div class="font-mono text-xs text-[var(--text-secondary)]">
            LOC: 31°13′N, 121°28′E
          </div>
        </div>
      </div>

      <!-- 右侧自述文字 -->
      <div class="about-text glass-panel p-8 sm:p-10 rounded-2xl border border-[var(--border-color)] shadow-xl flex flex-col justify-between space-y-6">
        <div>
          <div class="text-xs font-mono text-[var(--text-secondary)] mb-2">// ABOUT_ME</div>
          <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal mb-6">自述</h1>
          
          <div class="space-y-4 font-sans text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed font-light">
            <p class="font-serif text-[var(--text-primary)] text-base sm:text-lg italic">
              大三学生，在潮湿的光线里写代码与文章。
            </p>
            <p>
              秋招的邮箱安静得像废弃的站台，投出去的简历大多沉在雨里，没有回音。无人问津的日子里，文字与代码成了唯一亮着的两盏灯。
            </p>
            <p>
              相信简洁（KISS）胜于复杂，相信第一性原理，也相信在冰冷的逻辑之外，技术可以有水墨般的呼吸感与温度。
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-[var(--border-color)] flex items-center justify-between text-xs font-mono text-[var(--text-secondary)]">
          <span>— Lao Liu</span>
          <span>写于三月的一个雨天</span>
        </div>
      </div>
    </div>

    <!-- 技能与工坊储备 (Skill Matrix) -->
    <div class="space-y-6">
      <div class="flex justify-between items-baseline border-b border-[var(--border-color)] pb-3">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--text-primary)]"></span>
          <h2 class="font-serif text-xl sm:text-2xl font-normal text-[var(--text-primary)]">技术工坊与偏好</h2>
        </div>
        <span class="text-xs font-mono text-[var(--text-secondary)]">// ARSENAL</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          skills.map((skillGroup) => (
            <div class="spotlight-card p-6 rounded-2xl border border-[var(--border-color)]" data-spotlight>
              <div class="text-xs font-mono text-[var(--text-secondary)] mb-3 flex items-center justify-between">
                <span>// {skillGroup.category}</span>
                <span class="text-[10px] opacity-60">READY</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {skillGroup.items.map((item) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-[rgba(229,227,220,0.04)] border border-[rgba(229,227,220,0.08)] text-[var(--text-primary)]">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>
