---
import Base from '../layouts/Base.astro';

const skills = [
  { category: '核心语言', items: ['TypeScript', 'Rust', 'Go', 'Python', 'SQL'] },
  { category: '框架与全栈', items: ['Astro', 'React', 'Next.js', 'Node.js', 'Tailwind CSS'] },
  { category: '工程与基础设施', items: ['Docker', 'Vercel', 'Git / GitHub Actions', 'Vite', 'PostgreSQL'] },
  { category: '实验偏好', items: ['Web Audio API', '潮湿雨夜氛围', '山雾沉香调色'] },
];
---

<Base title="自述 — 屌丝" description="关于 Lao Liu：潮湿光线里的文字、经历与信号">
  <div class="about grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-12 pt-4">
    <!-- 左侧艺术图框 -->
    <div class="about-figure aspect-[3/4] bg-gradient-to-br from-[#2a2e38] to-[#14151a] border border-[rgba(229,227,220,0.12)] relative overflow-hidden rounded-none shadow-2xl">
      <div class="absolute inset-0 flex flex-col justify-between p-6 z-10">
        <div class="font-mono text-xs text-[#8c8d93]">// PORTRAIT</div>
        <div class="font-serif text-lg text-[#e5e3dc] italic">“大部分时间，我在等一种光。”</div>
      </div>
    </div>

    <!-- 右侧自述文字 -->
    <div class="about-text flex flex-col justify-center space-y-6">
      <h1 class="font-serif text-3xl sm:text-4xl text-[#e5e3dc] font-normal mb-2">自述</h1>
      
      <p class="text-base text-[#e5e3dc] font-serif leading-relaxed">
        大三屌丝，秋招实习无面试，写点文章。
      </p>

      <p class="text-sm text-[#8c8d93] font-sans leading-relaxed">
        秋招的邮箱安静得像废弃的站台，投出去的简历大多沉在雨里，没有回音。无人问津的日子里，文字成了唯一亮着的灯。
      </p>

      <div class="about-sign font-serif italic text-base text-[#e5e3dc] pt-4">
        — Lao Liu，写于三月的一个雨天
      </div>
    </div>
  </div>
</Base>
