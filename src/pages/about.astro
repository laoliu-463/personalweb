---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
const skills = [
  { category: '核心语言', items: ['TypeScript', 'Rust', 'Go', 'Python', 'SQL'] },
  { category: '框架与全栈', items: ['Astro', 'React', 'Next.js', 'Node.js', 'Tailwind CSS'] },
  { category: '工程与基础设施', items: ['Docker', 'Vercel', 'Git / GitHub Actions', 'Vite', 'PostgreSQL'] },
  { category: '实验偏好', items: ['Canvas 粒子', 'Web Audio API', '潮湿雨夜氛围', '水墨交互'] },
];
---
<Base title="自述 — 老刘" description="关于老刘：写代码，记想法，也记录日常。">
  <PageIntro eyebrow="03 / A LITTLE ABOUT ME" title="你好，我是老刘。" description="一张书桌，写代码，也写生活。" />
  <div class="page-content shell about-layout">
    <section class="about-prose" aria-label="个人自述" data-reveal>
      <p class="eyebrow">ABOUT ME</p><p class="about-lead" style="margin-top:24px">大三学生，在潮湿的光线里写代码与文章。</p>
      <p>秋招的邮箱安静得像废弃的站台，投出去的简历大多沉在雨里，没有回音。无人问津的日子里，文字与代码成了唯一亮着的两盏灯。</p>
      <p>相信简洁（KISS）胜于复杂，相信第一性原理，也相信在冰冷的逻辑之外，技术可以有水墨般的呼吸感与温度。</p>
      <p class="about-signature">Lao Liu</p>
      <a class="text-link" href="https://github.com/laoliu-463" target="_blank" rel="noopener noreferrer">在 GitHub 看看我 <span>↗</span></a>
    </section>
    <aside aria-label="技术与偏好">{skills.map(group => <section class="skill-group"><h3>{group.category}</h3><p>{group.items.join(' / ')}</p></section>)}</aside>
  </div>
</Base>
