---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getSortedArticles } from '../../lib/articles';

const articles = await getSortedArticles();
const techPosts = articles.filter((a) => a.data.category !== '随笔');
const essays = articles.filter((a) => a.data.category === '随笔');
---

<Base title="沉淀的文字 — 屌丝" description="在湿润夜色与灯光下写下的思考与工程记录">
  <div class="max-w-4xl">
    <div class="flex justify-between items-baseline border-b border-[rgba(229,227,220,0.12)] pb-6 mb-12">
      <h1 class="font-serif text-4xl font-normal text-[#e5e3dc]">沉淀的文字</h1>
      <span class="text-xs font-mono text-[#8c8d93]">COUNT: {articles.length}</span>
    </div>

    <div class="space-y-16">
      <!-- 技术博客区 -->
      <section>
        <div class="flex justify-between items-baseline border-b border-[rgba(229,227,220,0.12)] pb-3 mb-6">
          <h2 class="font-serif text-2xl font-normal text-[#e5e3dc]">技术博客</h2>
          <span class="text-xs font-mono text-[#8c8d93]">COUNT: {techPosts.length}</span>
        </div>
        {techPosts.length > 0 ? (
          <div class="space-y-6">
            {techPosts.map((article) => (
              <ArticleCard
                id={article.id}
                title={article.data.title}
                description={article.data.description}
                pubDate={article.data.pubDate}
                category={article.data.category}
                tags={article.data.tags}
                mood={article.data.mood}
              />
            ))}
          </div>
        ) : (
          <p class="text-xs font-mono text-[#646873]">// 还没有技术博客，等你写下第一篇。</p>
        )}
      </section>

      <!-- 随笔区 -->
      <section>
        <div class="flex justify-between items-baseline border-b border-[rgba(229,227,220,0.12)] pb-3 mb-6">
          <h2 class="font-serif text-2xl font-normal text-[#e5e3dc]">随笔</h2>
          <span class="text-xs font-mono text-[#8c8d93]">COUNT: {essays.length}</span>
        </div>
        {essays.length > 0 ? (
          <div class="space-y-6">
            {essays.map((article) => (
              <ArticleCard
                id={article.id}
                title={article.data.title}
                description={article.data.description}
                pubDate={article.data.pubDate}
                category={article.data.category}
                tags={article.data.tags}
                mood={article.data.mood}
              />
            ))}
          </div>
        ) : (
          <p class="text-xs font-mono text-[#646873]">// 还没有随笔。</p>
        )}
      </section>
    </div>
  </div>
</Base>
