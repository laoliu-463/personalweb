---
import Base from '../layouts/Base.astro';
import DeskScene from '../components/DeskScene.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getFeaturedProjects, mapRepoToCard } from '../lib/projects';
import { getSortedArticles } from '../lib/articles';
const projects = (await getFeaturedProjects(3)).map((repo, i) => mapRepoToCard(repo, i + 1));
const posts = (await getSortedArticles()).slice(0, 4);
---
<Base title="老刘 · 代码与文字之间">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow entrance">代码 · 文字 · 日常 <span> / </span> DESK NOTES</p>
      <h1 id="hero-title" class="entrance">在书桌前<br />慢慢写<span class="red-dot">。</span></h1>
      <p class="hero-intro entrance">你好，我是老刘。<br />写下白天没说完的话，做些自己相信的事。</p>
      <div class="hero-actions entrance"><a class="primary-link" href="#works">看看我的作品 <span>↗</span></a><a class="text-link" href="#writings">读一些文字 <span>↗</span></a></div>
      <p class="hero-footnote entrance"><span class="tiny-line"></span>一张书桌，写代码，也写生活。</p>
    </div>
    <DeskScene />
  </section>
  <div class="section-divider shell"><span>向下，看看最近在做什么</span><span>SCROLL TO EXPLORE ↓</span></div>
  <section id="works" class="content-section shell">
    <div class="section-heading" data-reveal><div><p class="eyebrow">01 / SELECTED WORKS</p><h2>把想法，做出来。</h2></div><a class="text-link" href="/projects/">全部作品 <span>↗</span></a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard {...project} />)}</div>
  </section>
  <section id="writings" class="content-section shell">
    <div class="section-heading" data-reveal><div><p class="eyebrow">02 / RECENT WRITING</p><h2>一些文字，一些思考。</h2></div><a class="text-link" href="/articles/">全部文章 <span>↗</span></a></div>
    {posts.map(post => <ArticleCard id={post.id} {...post.data} />)}
  </section>
  <section class="closing shell" data-reveal><p class="eyebrow">03 / A LITTLE ABOUT ME</p><h2>做有意思的事，<br />也做一个有意思的人。</h2><a class="text-link" href="/about/">再认识我一点 <span>↗</span></a><span class="closing-note" aria-hidden="true">To be<br />continued.</span></section>
</Base>
<style>
  .hero { height: calc(100svh - 98px); min-height: 860px; max-height: 960px; display: flex; position: relative; isolation: isolate; overflow: hidden; background: var(--night); color: #f1ede3; }
  .hero-copy { position: relative; z-index: 2; width: min(500px, 39%); margin-left: max(56px, calc((100vw - 1240px) / 2)); align-self: flex-end; margin-bottom: 62px; }
  .hero .eyebrow { color: #bdc3c5; font-size: 9px; letter-spacing: 2px; }
  .hero .eyebrow span { padding-inline: 12px; color: #b69c7c; }
  h1 { font: 400 clamp(50px, 4.6vw, 66px)/1.18 var(--font-serif); letter-spacing: 4px; margin-block: 16px 14px; }
  .red-dot { color: #ceaa7c; }
  .hero-intro { color: #bdc5c8; font-size: 12px; line-height: 2; }
  .hero-actions { display: flex; align-items: center; gap: 32px; margin-top: 22px; }
  .hero .text-link { color: #d9dddc; font-size: 12px; }
  .hero-footnote { display: flex; align-items: center; gap: 12px; font-size: 10px; color: #aeb9bd; margin-top: 24px; }
  .tiny-line { height: 1px; width: 25px; background: #ad9677; }
  h1.entrance { animation-delay: 60ms; }
  .hero-intro.entrance { animation-delay: 120ms; }
  .hero-actions.entrance { animation-delay: 180ms; }
  .hero-footnote.entrance { animation-delay: 240ms; }
  .section-divider { display: flex; justify-content: space-between; padding-top: 24px; font-size: 9px; letter-spacing: 1px; color: var(--muted); }
  @media (max-width: 1000px) and (min-width: 641px) { .hero-copy { margin-left: 32px; } .hero-actions { gap: 18px; } }
  @media (max-width: 640px) {
    .hero { height: calc(470px + 66.666667vw + 32px); min-height: 0; max-height: none; display: block; }
    .hero-copy { margin: 0 20px; padding-top: 42px; width: calc(100% - 40px); }
    h1 { font-size: 64px; line-height: 1.28; margin-block: 26px 22px; }
    .hero .eyebrow { font-size: 8px; letter-spacing: 1.8px; }
    .hero-actions { margin-top: 27px; gap: 27px; }
    .hero-footnote { margin-top: 34px; font-size: 9px; }
    .section-divider { font-size: 8px; }
    .section-divider span:last-child { display: none; }
  }
  @media (max-width: 360px) { h1 { font-size: 56px; } .hero-actions { gap: 18px; } }
</style>
