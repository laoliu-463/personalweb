---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, mapRepoToCard } from '../../lib/projects';

const repos = await getProjects();
const projects = repos.map((repo, i) => mapRepoToCard(repo, i + 1));
---

<Base title="作品集 — 雾隐 · Lao Liu" description="2019 — 2026 年间的代码实验与系统工程">
  <div class="max-w-5xl">
    <div class="flex justify-between items-baseline border-b border-[rgba(229,227,220,0.12)] pb-6 mb-12">
      <h1 class="font-serif text-4xl font-normal text-[#e5e3dc]">作品集</h1>
      <span class="text-xs font-mono text-[#8c8d93]">2019 — 2026</span>
    </div>

    <div class="work-list">
      {
        projects.map((proj) => (
          <ProjectCard
            index={proj.index}
            title={proj.title}
            description={proj.description}
            tags={proj.tags}
            github={proj.github}
            demo={proj.demo}
            year={proj.year}
          />
        ))
      }
    </div>
  </div>
</Base>
