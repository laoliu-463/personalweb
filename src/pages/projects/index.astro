---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, mapRepoToCard } from '../../lib/projects';
const repos = await getProjects();
const projects = repos.map((repo, i) => mapRepoToCard(repo, i + 1));
---
<Base title="作品 — 老刘" description="代码实验、工具与持续探索中的项目。">
  <PageIntro eyebrow="01 / PROJECTS & EXPERIMENTS" title="把想法，做出来。" description="写过的代码，做过的工具，以及还在继续的探索。" />
  <section class="page-content shell">
    <div class="section-heading"><div><p class="eyebrow">PROJECT ARCHIVE</p><h2>作品与实验</h2></div><span class="section-count">{projects.length} 个项目</span></div>
    <div class="project-grid">{projects.map(project => <ProjectCard {...project} />)}</div>
  </section>
</Base>
