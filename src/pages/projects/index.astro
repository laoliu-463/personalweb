---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, mapRepoToCard } from '../../lib/projects';

const repos = await getProjects();
const projects = repos.map((repo, i) => mapRepoToCard(repo, i + 1));
---

<Base title="作品集 — 屌丝" description="2019 — 2026 年间的代码实验与系统工程">
  <div class="max-w-5xl">
    <div class="flex justify-between items-baseline border-b border-[var(--border-color)] pb-6 mb-12">
      <div>
        <h1 class="font-serif text-3xl sm:text-4xl font-normal text-[var(--text-primary)]">作品集</h1>
        <p class="text-xs font-mono text-[var(--text-secondary)] mt-1.5">// ALL PROJECTS & LABS ({projects.length})</p>
      </div>
      <span class="text-xs font-mono text-[var(--text-secondary)]">2019 — 2026</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((proj, idx) => (
          <ProjectCard
            index={proj.index}
            title={proj.title}
            description={proj.description}
            tags={proj.tags}
            github={proj.github}
            demo={proj.demo}
            year={proj.year}
            featured={idx === 0 || (idx > 0 && idx % 5 === 0)}
          />
        ))
      }
    </div>
  </div>
</Base>
