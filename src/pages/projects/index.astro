---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getLocalProjects } from '../../lib/projects';

const projects = await getLocalProjects();
---

<Base title="作品集 — 雾隐 · Lao Liu" description="2019 — 2026 年间的代码实验与系统工程">
  <div class="max-w-5xl">
    <div class="flex justify-between items-baseline border-b border-[rgba(229,227,220,0.12)] pb-6 mb-12">
      <h1 class="font-serif text-4xl font-normal text-[#e5e3dc]">作品集</h1>
      <span class="text-xs font-mono text-[#8c8d93]">2019 — 2026</span>
    </div>

    <div class="work-list">
      {
        projects.map((proj, idx) => (
          <ProjectCard
            index={idx + 1}
            title={proj.data.title}
            description={proj.data.description}
            tags={proj.data.tags}
            github={proj.data.github}
            demo={proj.data.demo}
          />
        ))
      }
    </div>
  </div>
</Base>
